# 复制此文件为 .env 并填写配置。启动脚本自动读取 .env，已有环境变量优先。
# 推荐直接使用网页“知识配置 → 免费 API 与模型选择”，填写自己的 Key 后保存并测试。
# 网页保存的配置优先于以下环境变量；默认预选 OpenRouter 免费路由。
# 本地 PostgreSQL 由启动脚本通过 Docker Compose 启动。
POSTGRES_PASSWORD=
POSTGRES_USER=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
# 已有 PostgreSQL 实例时填写此项，直接检查连接。
# RAG_DATABASE_URL=postgresql://rag:password@127.0.0.1:5432/rag
RAG_POSTGRES_SCHEMA=public
# 网页迁移按钮的源文件，默认读取 data/rag.sqlite3。
# RAG_LEGACY_DB=data/rag.sqlite3
# 留空时启动脚本会通过 Docker Compose 启动本地 Chroma，并把连接配置写入 .env。
# Chroma Cloud：
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=product-manuals
# 已有自管 Chroma HTTP 服务可用（无需 CHROMA_MANAGED）：
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8001
# CHROMA_SSL=0
# 可选对照方案为 hash、bm25 和 semantic（FAISS）。
RAG_RETRIEVER=hybrid
RAG_ANSWER_MODE=extractive
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# API 向量服务时改为 api，并分别填写以下三项：
# EMBEDDING_BASE_URL=https://your-provider.example/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=your-embedding-model
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=
# 本地模型下载缓存可选：HF_HOME=/your/writable/model-cache
